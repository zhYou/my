# GitHub Actions workflow 静态检查。

prefix_rule(
    pattern = ["actionlint"],
    decision = "allow",
    justification = "检查 GitHub Actions 工作流",
    match = [
        "actionlint",
        "actionlint -shellcheck= -pyflakes=",
    ],
    not_match = ["golangci-lint run"],
)

prefix_rule(
    pattern = ["rtk", "actionlint"],
    decision = "allow",
    justification = "通过 RTK 检查 GitHub Actions 工作流",
    match = ["rtk actionlint -shellcheck= -pyflakes="],
    not_match = ["rtk golangci-lint run"],
)
