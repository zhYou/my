#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
bootstrap_root="$(mktemp -d "${TMPDIR:-/tmp}/verify-bootstrap.XXXXXX")"

cleanup() {
  chmod -R u+w "$bootstrap_root" 2>/dev/null || true
  rm -rf -- "$bootstrap_root"
}
trap cleanup EXIT HUP INT TERM

export GOCACHE="$bootstrap_root/go-cache"
cd "$repo_root"
go run ./tools/verify "$@"
